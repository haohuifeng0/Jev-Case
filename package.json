{
  "name": "jev-signal-show",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "catalog:import": "node --experimental-strip-types scripts/import-awesome-jev.mjs",
    "catalog:check": "node --experimental-strip-types scripts/import-awesome-jev.mjs --check",
    "catalog:finalize": "node --experimental-strip-types scripts/import-awesome-jev.mjs --finalize",
    "validate:business": "node scripts/validate-business.mjs",
    "validate:data": "node --experimental-strip-types scripts/validate-data.mjs",
    "test:catalog": "node --test scripts/test-import-awesome-jev.mjs scripts/test-catalog-transaction.mjs scripts/test-catalog-provenance.mjs scripts/test-catalog-download.mjs scripts/test-catalog-source-config.mjs",
    "test:data": "node --test scripts/test-validate-data.mjs",
    "test:assessment": "node --experimental-strip-types --test scripts/test-assessment-form.mjs",
    "test:ci-config": "node scripts/test-ci-config-regression.mjs && node scripts/test-ci-order.mjs",
    "test:smoke": "node scripts/run-smoke.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.8",
    "astro": "^7.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
