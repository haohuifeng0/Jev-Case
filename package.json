{
  "name": "jev-signal-show",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/start-preview.mjs",
    "check": "astro check",
    "catalog:import": "node --experimental-strip-types scripts/import-awesome-jev.mjs",
    "catalog:check": "node --experimental-strip-types scripts/import-awesome-jev.mjs --check",
    "catalog:finalize": "node --experimental-strip-types scripts/import-awesome-jev.mjs --finalize",
    "validate:business": "node scripts/validate-business.mjs",
    "validate:data": "node --experimental-strip-types scripts/validate-data.mjs",
    "test:catalog": "node --test scripts/test-import-awesome-jev.mjs scripts/test-catalog-transaction.mjs scripts/test-catalog-provenance.mjs scripts/test-catalog-download.mjs scripts/test-catalog-source-config.mjs",
    "test:data": "node --experimental-strip-types --test scripts/test-validate-data.mjs scripts/test-project-case-relations.mjs scripts/test-project-pages.mjs scripts/test-verification-rules.mjs scripts/test-scenarios.mjs",
    "report:relations": "node --experimental-strip-types scripts/report-project-case-relations.mjs",
    "report:verifications": "node --experimental-strip-types scripts/report-model-routing-verifications.mjs",
    "report:tool-skill-verifications": "node --experimental-strip-types scripts/report-tool-skill-verifications.mjs",
    "report:risk-gate-verifications": "node --experimental-strip-types scripts/report-risk-gate-verifications.mjs",
    "report:output-verifications": "node --experimental-strip-types scripts/report-output-verifications.mjs",
    "test:verifications": "node --experimental-strip-types --test scripts/test-model-routing-verifications.mjs scripts/test-tool-skill-verifications.mjs scripts/test-risk-gate-verifications.mjs scripts/test-output-verifications.mjs",
    "test:assessment": "node --experimental-strip-types --test scripts/test-assessment-form.mjs",
    "test:metadata": "node --experimental-strip-types --test scripts/test-metadata-security.mjs scripts/test-built-site.mjs",
    "validate:operations": "node scripts/validate-operations.mjs --check",
    "test:operations": "node --test scripts/test-operations-content-safety.mjs && node scripts/test-operations.mjs",
    "test:ci-config": "node scripts/test-ci-config-regression.mjs && node scripts/test-ci-order.mjs",
    "catalog:cadence": "node scripts/check-catalog-refresh.mjs",
    "report:verification-expiry": "node scripts/report-verification-expiry.mjs",
    "generate:kpi": "node scripts/generate-kpi-worksheet.mjs",
    "review:cycle": "node scripts/review-operating-cycle.mjs",
    "launch:dry-run": "node scripts/launch-dry-run.mjs",
    "test:launch": "node --test scripts/test-launch-readiness.mjs scripts/test-launch-tools.mjs && node scripts/test-static-build-determinism.mjs",
    "test:smoke": "node scripts/run-smoke.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.8",
    "astro": "^7.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
