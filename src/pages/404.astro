---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBasePath } from "../lib/metadata";
const homeHref = withBasePath("/", import.meta.env.BASE_URL);
---

<BaseLayout title="Signal not found | JEV Signal" description="没有找到这条案例。">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <section class="empty-state full">
    <p class="eyebrow">404 / SIGNAL LOST</p>
    <h1>这条信号不存在。</h1>
    <a class="source-button compact" href={homeHref}>返回案例流</a>
  </section>
</BaseLayout>
